<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ZaibBrain AI</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>
  <div id="landing">
    <img src="https://files.catbox.moe/8w0keg.jpg/logo.png" alt="ZaibBrain Logo" class="logo" />
    <h1>Welcome to ZaibBrain</h1>
    <p>Your Personal AI Assistant</p>
    <button onclick="startChat()">Chat Now</button>
  </div>

  <div id="chat" style="display: none;">
    <div class="chat-header">ZaibBrain - AI Chat</div>
    <div class="chat-box" id="chat-box"></div>
    <div class="input-area">
      <input type="text" id="user-input" placeholder="Type your message..." />
      <button onclick="sendMessage()">Send</button>
    </div>
  </div>

  <script src="script.js"></script>
</body>
</html>
